    "plt.xlabel(\"Predicted\")\n",
    "plt.ylabel(\"Actual\")\n",
    "plt.title(\"Credit-risk model confusion matrix\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIGURE_DIR / \"model_confusion_matrix.png\", dpi=140, bbox_inches=\"tight\")\n",
